			"net.trashelemental.dracolotl.Dracolotl"
		],
		"client": [
			"net.trashelemental.dracolotl.client.DracolotlClient"
		],
		"jei_mod_plugin": [
			"net.trashelemental.dracolotl.compat.JEI.JEIDracolotlPlugin"
