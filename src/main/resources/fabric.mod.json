	"authors": [
		"TrashElemental",
		"\u9752\u8863\u7483"
	],
	"contact": {
		"homepage": "https://curseforge.com/minecraft/mc-mods/dracolotl"
	},
	"license": "MIT",
	"icon": "assets/dracolotl/icon.png",
	"environment": "*",
	"entrypoints": {
